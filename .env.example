# Copie para .env (já está no .gitignore). NUNCA commite a chave.

# --- Google AI Studio ---
GEMINI_API_KEY=
# Configurável para não depender de código quando o modelo for aposentado.
# Confira o nome vigente em AI Studio / página de deprecations.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Camada de IA generativa ---
IOT_IDS_LLM_HABILITADO=true
# auto   = o backend chama a API sozinho quando um incidente se estabiliza
# manual = só chama quando o operador clica em "Gerar análise"
IOT_IDS_LLM_MODO=auto
IOT_IDS_LLM_ESTABILIDADE_S=6        # incidente precisa persistir N s antes da 1ª chamada
IOT_IDS_LLM_COOLDOWN_S=30           # intervalo mínimo entre chamadas automáticas
IOT_IDS_LLM_MANUAL_MIN_S=15         # intervalo mínimo do botão, por incidente
IOT_IDS_LLM_CACHE_TTL_S=900         # validade do relatório por assinatura de incidente
IOT_IDS_LLM_MAX_CHAMADAS_HORA=20    # orçamento rígido (janela deslizante de 1 h)
IOT_IDS_LLM_MAX_INCIDENTES=3        # incidentes agrupados em 1 relatório
IOT_IDS_LLM_TIMEOUT_S=25
IOT_IDS_LLM_BACKOFF_ERRO_S=60
IOT_IDS_LLM_BACKOFF_429_S=180